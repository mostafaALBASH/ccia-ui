{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck-on-edit.cjs",
            "async": true,
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "Typechecking edited file"
          }
        ]
      }
    ]
  }
}
